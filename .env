
# Flask 기본 설정
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here-change-in-production
PORT=5000


# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=your-db-password-here
DB_NAME=privalert
DB_SSL_MODE=REQUIRED
# DB_SSL_MODE 옵션: REQUIRED, VERIFY_IDENTITY, DISABLED
# 개발 환경에서는 DISABLED 가능, 프로덕션은 REQUIRED 이상 권장


# 비밀번호 보안 (Pepper)
PASSWORD_PEPPER=your-pepper-key-here-change-in-production
# 프로덕션에서는 KMS 또는 HashiCorp Vault에서 관리 권장


# 관리자 계정 (초기 설정용)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here
# init_db.py 실행 시 이 계정이 자동 생성됨


# CORS 설정
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 프론트엔드 URL들을 쉼표로 구분


# 로깅 설정
LOG_LEVEL=INFO
# 옵션: DEBUG, INFO, WARNING, ERROR, CRITICAL


# 파일 업로드 제한
MAX_CONTENT_LENGTH=10
# 단위: MB (기본값: 10MB)


# OpenAI API (GPT 서비스용)
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini

