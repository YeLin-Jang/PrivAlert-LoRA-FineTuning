# Flake8 설정 파일
# Python 코드 품질 검사 도구 설정

[flake8]
# 최대 줄 길이
max-line-length = 120

# 무시할 오류 코드
# E501: 줄 길이 초과 (max-line-length로 제어)
# W503: 줄바꿈 전 이항 연산자 (PEP 8 권장사항과 충돌)
# E203: 화이트스페이스 오류 (black과 충돌)
ignore = E501, W503, E203

# 제외할 디렉토리/파일
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .env,
    build,
    dist,
    *.egg-info,
    migrations,
    models/ner_model/bertviz,  # 서드파티 코드 제외
    node_modules,
    .pytest_cache,
    .mypy_cache,
    instance,
    data/results

# 포함할 파일 확장자
filename = *.py

# 최대 복잡도 (기본값: 10)
max-complexity = 15

# 통계 표시
statistics = True

# 소스 코드 표시
show-source = True

# 각 파일별 오류 개수 표시
count = True

# 임포트 순서 검사 (isort와 함께 사용)
import-order-style = google


